<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- PERMISO AGREGADO PARA GUARDAR PDF Y CSV (HU-006.2, HU-005) -->
    <!-- Se requiere SOLO para guardar archivos en dispositivos con API 28 (Android 9) o inferior -->
    <!-- Android 10+ (API 29+) usa MediaStore y no requiere este permiso -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" 
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FinanceTracker"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false" />

        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".ui.dashboard.DashboardActivity"
            android:exported="false" />

        <activity
            android:name=".ui.transaction.TransactionActivity"
            android:exported="false" />

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.category.CategoryActivity"
            android:exported="false" />

        <!-- NUEVA ACTIVIDAD: ChangePasswordActivity -->
        <activity
            android:name=".ui.settings.ChangePasswordActivity"
            android:exported="false" />

        <!-- NUEVA ACTIVIDAD: NewCategoryActivity -->
        <activity android:name=".ui.category.NewCategoryActivity"
            android:exported="false" />

        <!-- ReportsActivity - HU-004 -->
        <activity
            android:name=".ui.reports.ReportsActivity"
            android:exported="false" />

        <!-- TransactionHistoryActivity - HU-005 -->
        <activity
            android:name=".ui.transaction.TransactionHistoryActivity"
            android:exported="false" />

        <!-- FileProvider para compartir archivos CSV/PDF de manera segura -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
